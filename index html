<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>نادي علوم الرياضة - جامعة بيشة</title>

    <style>

        /* إعدادات الصفحة */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background-color: #f4f7f6;
            color: #333;
        }

        /* الهيدر */
        header {
            background-color: #004d40;
            color: white;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        /* اللوقو */
        .header-logo {
            width: 75px;
            height: 75px;
            object-fit: contain;

            background-color: white;
            padding: 5px;
            border-radius: 50%;

            flex-shrink: 0;
        }

        /* النص الموجود بجانب اللوقو */
        .header-text {
            text-align: right;
        }

        header h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
        }

        header h2 {
            margin: 3px 0;
            font-size: 17px;
            font-weight: 400;
            color: #e0f2f1;
        }

        /* محتوى الصفحة */
        .container {
            width: 90%;
            max-width: 850px;
            margin: 35px auto;
            background-color: white;
            padding: 30px;
            border-radius: 12px;

            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        /* قسم الإعلانات */
        .announcements {
            background-color: #e0f2f1;
            border-right: 5px solid #004d40;
            padding: 20px;
            border-radius: 8px;
            text-align: right;
        }

        .announcements h3 {
            margin-top: 0;
            color: #004d40;
            font-size: 22px;
        }

        .announcements p {
            color: #555;
            line-height: 1.8;
        }

        /* إزالة تكرار اللوقو من الإعلانات */
        .announcement-box {
            background-color: white;
            padding: 15px;
            border-radius: 6px;
            margin-top: 15px;
        }

        /* الفوتر */
        footer {
            margin-top: 40px;
            padding: 18px;
            background-color: #003d33;
            color: white;
            text-align: center;
            font-size: 14px;
        }

        /* تنسيق الجوال */
        @media (max-width: 600px) {

            header {
                padding: 15px;
                gap: 12px;
            }

            .header-logo {
                width: 60px;
                height: 60px;
            }

            header h1 {
                font-size: 21px;
            }

            header h2 {
                font-size: 14px;
            }

            .container {
                width: 94%;
                padding: 20px;
                margin-top: 20px;
            }

        }

    </style>
</head>


<body>

    <!-- الهيدر -->
    <header>

        <img
            src="11547272-cb99-4086-964c-3e29e1b9ec62.jpg"
            alt="شعار نادي علوم الرياضة"
            class="header-logo"
        >

        <div class="header-text">

            <h1>نادي علوم الرياضة</h1>

            <h2>كلية التربية والتنمية البشرية</h2>

            <h2>جامعة بيشة</h2>

        </div>

    </header>


    <!-- محتوى الصفحة -->
    <main class="container">

        <div class="announcements">

            <h3>📢 قسم الإعلانات</h3>

            <div class="announcement-box">

                <p>
                    سيتم عرض إعلانات وفعاليات نادي علوم الرياضة هنا.
                </p>

            </div>

        </div>

    </main>


    <!-- أسفل الصفحة -->
    <footer>

        نادي علوم الرياضة © 2026  
        <br>
        جامعة بيشة - كلية التربية والتنمية البشرية

    </footer>

</body>

</html>
